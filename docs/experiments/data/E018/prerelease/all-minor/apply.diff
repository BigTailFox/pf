+# PF dogfood (E018): search packages/markitdown only, extra all only.
+# Self-reference markitdown[all] makes all the required surface; extra-policy none
+# does not add the empty / no-extra cell. Do not use extra-policy=all.
+# openai matches hatch-test; GITHUB_ACTIONS is set by the runner, not here.
+# test-jobs=1 avoids /tmp rlink races. resolve-artifact any builds the local snapshot.
+[dependency-groups]
+pf-test = [
+  "markitdown[all]",
+  "pytest",
+  "openai",
+]
+
+[tool.pf]
+pythons = ["3.10"]
+test-group = "pf-test"
+extra-policy = "none"
+test-command = ["pytest"]
+resolve-artifact = "any"
+test-timeout = "2h"
+test-jobs = 1
+search-space = "all"
+search-resolution = "minor"
+
