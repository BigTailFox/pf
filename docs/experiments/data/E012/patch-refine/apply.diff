+    "blinker>=1.7.0; python_version == \"3.14\"",
+    "blinker>=1.6; python_version == \"3.10\" or python_version == \"3.11\" or python_version == \"3.12\" or python_version == \"3.13\"",
+    "click>=8.0.0",
